// Prisma schema for the Task Management System.
// Screen 1: User model (guest login).
// Screen 2: Task, Label, TaskLabel, TaskMember models + enums.
// Screen 4: TaskResource, TaskComment, TaskActivity, Team models + parentTaskId, startDate, endDate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum TaskStatus {
  TODO
  DOING
  COMPLETED
  ON_HOLD
}

enum TaskPriority {
  NO_PRIORITY
  URGENT
  HIGH
  MEDIUM
  LOW
}

// ---------- Models ----------

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String?  @unique
  name      String?
  isGuest   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdTasks Task[]       @relation("TaskCreator")
  taskMembers  TaskMember[]
  taskLabels   TaskLabel[]
  comments     TaskComment[]
  activities   TaskActivity[]
  resources    TaskResource[]
  teams        Team[]

  @@map("users")
}

model Team {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String @db.Uuid
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  tasks Task[]

  @@index([createdById])
  @@map("teams")
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(NO_PRIORITY)
  dueDate     DateTime?
  startDate   DateTime?
  endDate     DateTime?
  parentTaskId String?     @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  createdById String       @db.Uuid
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)

  parentTask   Task?        @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subTasks     Task[]       @relation("SubTasks")
  teamId       String?      @db.Uuid
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  members TaskMember[]
  labels  TaskLabel[]
  comments TaskComment[]
  activities TaskActivity[]
  resources TaskResource[]

  @@index([createdById, status])
  @@index([createdById, priority])
  @@index([parentTaskId])
  @@index([createdAt])
  @@map("tasks")
}

model TaskMember {
  id     String @id @default(uuid()) @db.Uuid
  taskId String @db.Uuid
  userId String @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_members")
}

model Label {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  tasks TaskLabel[]

  @@map("labels")
}

model TaskLabel {
  id      String @id @default(uuid()) @db.Uuid
  taskId  String @db.Uuid
  labelId String @db.Uuid
  userId  String @db.Uuid

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, labelId])
  @@index([userId])
  @@map("task_labels")
}

model TaskResource {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @db.Uuid
  userId      String   @db.Uuid
  name        String
  url         String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@map("task_resources")
}

model TaskComment {
  id              String    @id @default(uuid()) @db.Uuid
  taskId          String    @db.Uuid
  userId          String    @db.Uuid
  content         String
  parentCommentId String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  task   Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent TaskComment? @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies TaskComment[] @relation("CommentReplies")

  @@index([taskId])
  @@index([userId])
  @@index([parentCommentId])
  @@index([createdAt])
  @@map("task_comments")
}

model TaskActivity {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  userId    String   @db.Uuid
  type      String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([createdAt])
  @@map("task_activities")
}