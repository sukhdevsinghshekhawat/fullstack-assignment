// Prisma schema for the Task Management System.
// Screen 1: User model (guest login).
// Screen 2: Task, Label, TaskLabel, TaskMember models + enums.
// Screen 4: TaskResource, TaskComment, TaskActivity, Team models + parentTaskId, startDate, endDate.
// Screen 7: Profile/Settings — added fullName, title, username, avatarUrl to User;
//           added Workspace and WorkspaceMember models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum TaskStatus {
  TODO
  DOING
  COMPLETED
  ON_HOLD
}

enum TaskPriority {
  NO_PRIORITY
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum WorkspaceMemberRole {
  OWNER
  MEMBER
}

// ---------- Models ----------

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String?  @unique
  name      String?
  fullName  String?
  title     String?
  username  String?  @unique
  avatarUrl String?
  isGuest   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdTasks         Task[]            @relation("TaskCreator")
  taskMembers          TaskMember[]
  taskLabels           TaskLabel[]
  comments             TaskComment[]
  activities           TaskActivity[]
  resources            TaskResource[]
  teams                Team[]
  createdProjects      Project[]         @relation("ProjectCreator")
  leadProjects         Project[]         @relation("ProjectLead")
  workspaceMemberships WorkspaceMember[]
  sessions             Session[]

  @@map("users")
}

model Team {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String @db.Uuid
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  tasks Task[]

  @@index([createdById])
  @@map("teams")
}

model Project {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  description String?
  priority    TaskPriority @default(NO_PRIORITY)
  dueDate     DateTime?
  leadId      String?      @db.Uuid
  createdById String       @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  lead      User?  @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  createdBy User   @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([createdById])
  @@index([leadId])
  @@index([createdAt])
  @@map("projects")
}

model Task {
  id           String       @id @default(uuid()) @db.Uuid
  title        String
  description  String?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(NO_PRIORITY)
  dueDate      DateTime?
  startDate    DateTime?
  endDate      DateTime?
  parentTaskId String?      @db.Uuid
  projectId    String?      @db.Uuid
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  createdById String @db.Uuid
  createdBy   User   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)

  parentTask Task?    @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subTasks   Task[]   @relation("SubTasks")
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  teamId     String?  @db.Uuid
  team       Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  members    TaskMember[]
  labels     TaskLabel[]
  comments   TaskComment[]
  activities TaskActivity[]
  resources  TaskResource[]

  @@index([createdById, status])
  @@index([createdById, priority])
  @@index([parentTaskId])
  @@index([projectId])
  @@index([createdAt])
  @@map("tasks")
}

model TaskMember {
  id     String @id @default(uuid()) @db.Uuid
  taskId String @db.Uuid
  userId String @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_members")
}

model Label {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  tasks TaskLabel[]

  @@map("labels")
}

model TaskLabel {
  id      String @id @default(uuid()) @db.Uuid
  taskId  String @db.Uuid
  labelId String @db.Uuid
  userId  String @db.Uuid

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, labelId])
  @@index([userId])
  @@map("task_labels")
}

model TaskResource {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @db.Uuid
  userId      String   @db.Uuid
  name        String
  url         String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@map("task_resources")
}

model TaskComment {
  id              String   @id @default(uuid()) @db.Uuid
  taskId          String   @db.Uuid
  userId          String   @db.Uuid
  content         String
  parentCommentId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  task    Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  TaskComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies TaskComment[] @relation("CommentReplies")

  @@index([taskId])
  @@index([userId])
  @@index([parentCommentId])
  @@index([createdAt])
  @@map("task_comments")
}

model TaskActivity {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  userId    String   @db.Uuid
  type      String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([createdAt])
  @@map("task_activities")
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members WorkspaceMember[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String              @id @default(uuid()) @db.Uuid
  workspaceId String              @db.Uuid
  userId      String              @db.Uuid
  role        WorkspaceMemberRole @default(MEMBER)
  joinedAt    DateTime            @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// Persistent session store for guest sessions.
// Stores a session token mapped to a user so sessions survive server restarts.
model Session {
  token     String   @id
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}
